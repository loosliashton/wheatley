# ==============================================================================
# Wheatley Secrets Template
# ==============================================================================
# Copy this file to /etc/wheatley/secrets.env and restrict permissions:
#   sudo cp .env.example /etc/wheatley/secrets.env
#   sudo chown wheatley:wheatley /etc/wheatley/secrets.env
#   sudo chmod 600 /etc/wheatley/secrets.env
# ==============================================================================

# LLM API Keys (Bring Your Own LLM)
# Use GEMINI_API_KEY for Google Gemini:
GEMINI_API_KEY="AIzaSyDummyKeyForValidationOnly"
# Use OPENAI_API_KEY for OpenAI / Ollama / local endpoints:
OPENAI_API_KEY=""
# Use GROQ_API_KEY for Groq:
GROQ_API_KEY=""

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Your numeric Telegram User ID (from @userinfobot or similar)
TELEGRAM_USER_ID="123456789"

# Optional PIN for high-risk approvals (leave empty if not needed)
HIGH_RISK_PIN=""

# Proxmox API Tokens (format: USER@REALM!TOKENID=UUID-SECRET)
# Node: pve-node-01
NODE1_TOKEN_MONITOR="wheatley@pve!bot=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
NODE1_TOKEN_OPS="wheatley@pve!bot=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
NODE1_TLS_FINGERPRINT="XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX"

# Node: pve-node-02
NODE2_TOKEN_MONITOR="wheatley@pve!bot=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
NODE2_TOKEN_OPS="wheatley@pve!bot=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
NODE2_TLS_FINGERPRINT="XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX"
