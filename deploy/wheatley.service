[Unit]
Description=Wheatley Homelab AI Monitoring & Administration Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wheatley
Group=wheatley
WorkingDirectory=/opt/wheatley
EnvironmentFile=-/etc/wheatley/secrets.env
ExecStart=/opt/wheatley/venv/bin/wheatley run --config /etc/wheatley/config.yaml --secrets /etc/wheatley/secrets.env
Restart=always
RestartSec=5s

# Security sandboxing within LXC
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/wheatley /var/log/wheatley /etc/wheatley/checks.yaml /tmp
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
