# ==============================================================================
# Wheatley Homelab Agent - Secrets Configuration Template
# ==============================================================================
# Seeded automatically into /etc/wheatley/secrets.env by install/create-lxc.sh.
# If copying manually, copy to /etc/wheatley/secrets.env and restrict permissions:
#   sudo cp /opt/wheatley/secrets.example.env /etc/wheatley/secrets.env
#   sudo chown wheatley:wheatley /etc/wheatley/secrets.env
#   sudo chmod 600 /etc/wheatley/secrets.env
#
# Values defined here are automatically interpolated into /etc/wheatley/config.yaml
# and /etc/wheatley/checks.yaml using the ${VAR} or ${VAR:-default} syntax.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Keys (Bring Your Own LLM)
# ------------------------------------------------------------------------------
# Google Gemini (recommended for fast cloud reasoning)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyDummyKeyForValidationOnly"

# OpenAI or OpenAI-compatible local endpoints (Ollama, vLLM, LocalAI)
# If using local Ollama, OPENAI_API_KEY can be any dummy string like "ollama"
OPENAI_API_KEY=""

# Groq (for ultra-fast cloud inference on Llama models)
GROQ_API_KEY=""

# ------------------------------------------------------------------------------
# 2. Telegram Bot Configuration
# ------------------------------------------------------------------------------
# Bot token generated by @BotFather on Telegram (format: 123456789:ABCdefGHI...)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Your numeric Telegram user ID (from @userinfobot or @userinfobot).
# Wheatley strictly ignores messages from any user ID not in allowed_user_ids.
TELEGRAM_USER_ID="123456789"

# ------------------------------------------------------------------------------
# 3. Proxmox VE Node API Tokens & TLS Fingerprints
# ------------------------------------------------------------------------------
# Generated automatically on your PVE hosts by running:
#   ./install/host-setup.sh
# Token format: USER@REALM!TOKENID=UUID-SECRET
#
# Primary Node (e.g. pve-node-01)
NODE1_TOKEN_MONITOR="wheatley@pve!bot=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
NODE1_TLS_FINGERPRINT="XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX"

# Secondary Node (e.g. pve-node-02) - optional if multi-node cluster
NODE2_TOKEN_MONITOR="wheatley@pve!bot=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
NODE2_TLS_FINGERPRINT="XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX"

# ------------------------------------------------------------------------------
# 4. Webhook Receiver Secret Token
# ------------------------------------------------------------------------------
# Shared secret required on every POST to /webhook/pve and /webhook/generic
# (sent as 'Authorization: Bearer <token>' or 'X-Wheatley-Token: <token>').
# Requests are REJECTED (401) while this is empty or left at the placeholder.
# install/create-lxc.sh replaces the placeholder with a random value automatically.
# Generate manually with: python3 -c "import secrets; print(secrets.token_hex(24))"
WEBHOOK_SECRET_TOKEN="change-me-to-a-random-secret-string"

# ------------------------------------------------------------------------------
# 5. Optional External Watchdog Push URL
# ------------------------------------------------------------------------------
# Heartbeat URL for external monitoring (Uptime Kuma, healthchecks.io, Gatus).
# Wheatley sends a GET/POST request here while healthy, stopping if degraded.
HEALTH_PUSH_URL=""
